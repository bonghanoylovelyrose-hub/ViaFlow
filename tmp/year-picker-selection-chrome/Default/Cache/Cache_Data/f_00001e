    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select[data-clearable-filter]').forEach(function (select, index) {
                if (!Array.from(select.options).some(function (option) { return option.hasAttribute('selected'); })) {
                    select.selectedIndex = -1;
                }
                const defaults = {
                    status: 'All Status', application_status: 'All Status', notice_status: 'All Status',
                    channel: 'All Methods', payment_type: 'All Types', type: 'All Types',
                    category: 'All Categories', month: 'All Months', year: 'All Years',
                    membership: 'All Memberships', notice_membership: 'All Memberships'
                };
                const label = select.dataset.filterDefault || defaults[select.name];
                if (!label) return;
                const value = document.createElement('span');
                value.className = 'status-filter-value';
                value.id = 'filter-default-' + index;
                value.textContent = label;
                value.style.fontSize = window.getComputedStyle(select).fontSize;
                select.parentElement.classList.add('status-filter-display');
                select.insertAdjacentElement('afterend', value);
                const update = function () {
                    const empty = select.selectedIndex < 0;
                    value.hidden = !empty;
                    if (empty) select.setAttribute('aria-describedby', value.id);
                    else select.removeAttribute('aria-describedby');
                };
                select.addEventListener('change', update);
                update();
            });
            document.querySelectorAll('form[data-auto-filter]').forEach(function (form) {
                let timer = null;

                const clearTimer = function () {
                    if (timer !== null) {
                        window.clearTimeout(timer);
                        timer = null;
                    }
                };

                const submit = function () {
                    clearTimer();

                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                };

                const scheduleSubmit = function () {
                    clearTimer();

                    const configuredDelay = Number(form.dataset.autoFilterDebounce);
                    const delay = Number.isFinite(configuredDelay) && configuredDelay >= 0
                        ? configuredDelay
                        : 450;

                    timer = window.setTimeout(submit, delay);
                };

                form.querySelectorAll('select, input[type="month"], input[type="date"], input[type="week"], input[type="time"], input[type="checkbox"], input[type="radio"]').forEach(function (control) {
                    control.addEventListener('change', submit);
                });

                form.querySelectorAll('input[type="search"], input[type="text"]').forEach(function (input) {
                    input.addEventListener('input', scheduleSubmit);
                    input.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            submit();
                        }
                    });
                });

                form.addEventListener('submit', clearTimer);
                form.addEventListener('year-picker-open', clearTimer);

                form.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', clearTimer);
                });

                document.addEventListener('click', function (event) {
                    if (!form.contains(event.target)) {
                        clearTimer();
                    }
                }, true);

                window.addEventListener('pagehide', clearTimer);
            });
        });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const appShell = document.querySelector('.app-shell');
        const sidebar = document.getElementById('sidebarMenu');
        const collapseToggle = document.getElementById('sidebarCollapseToggle');
        const mobileToggle = document.getElementById('sidebarMobileToggle');
        const backdrop = document.getElementById('sidebarBackdrop');
        const mainContent = document.querySelector('.main-content');

        if (!appShell || !sidebar) {
            return;
        }

        const mobileQuery = window.matchMedia('(max-width: 991.98px)');
        const toggles = [collapseToggle, mobileToggle].filter(Boolean);

        const isMobile = function () {
            return mobileQuery.matches;
        };

        const isSidebarOpen = function () {
            return isMobile()
                ? appShell.classList.contains('sidebar-mobile-open')
                : !appShell.classList.contains('sidebar-collapsed');
        };

        const syncState = function () {
            const open = isSidebarOpen();

            toggles.forEach(function (toggle) {
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });

            if (collapseToggle) {
                const label = open ? 'Collapse sidebar' : 'Open sidebar';

                collapseToggle.setAttribute('aria-label', label);
                collapseToggle.setAttribute('title', label);
            }

            if (mobileToggle) {
                const label = open ? 'Close sidebar' : 'Open sidebar';

                mobileToggle.setAttribute('aria-label', label);
                mobileToggle.setAttribute('title', label);
            }

            sidebar.toggleAttribute('inert', isMobile() && !open);

            if (mainContent) {
                mainContent.toggleAttribute('inert', isMobile() && open);
            }
        };

        const openSidebar = function () {
            if (isMobile()) {
                appShell.classList.add('sidebar-mobile-open');
            } else {
                appShell.classList.remove('sidebar-collapsed');
            }

            syncState();

            const firstLink = sidebar.querySelector('.nav-link:not(.sidebar-subnav-link)')
                || sidebar.querySelector('.nav-link');

            if (isMobile() && firstLink) {
                window.setTimeout(function () {
                    firstLink.focus();
                }, 0);
            }
        };

        const closeSidebar = function () {
            if (isMobile()) {
                appShell.classList.remove('sidebar-mobile-open');
            } else {
                appShell.classList.add('sidebar-collapsed');
            }

            syncState();

            const focusTarget = isMobile() && mobileToggle ? mobileToggle : collapseToggle;

            if (focusTarget) {
                window.setTimeout(function () {
                    focusTarget.focus();
                }, 0);
            }
        };

        const toggleSidebar = function () {
            if (isSidebarOpen()) {
                closeSidebar();
            } else {
                openSidebar();
            }
        };

        toggles.forEach(function (toggle) {
            toggle.addEventListener('click', toggleSidebar);
        });

        sidebar.querySelectorAll('.sidebar-submenu-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function (event) {
                if (!isMobile() && appShell.classList.contains('sidebar-collapsed')) {
                    const submenu = document.getElementById(toggle.getAttribute('aria-controls'));
                    openSidebar();
                    // An already-open submenu becomes visible as the rail expands.
                    if (submenu && submenu.classList.contains('show')) event.stopPropagation();
                }
            });
        });

        if (backdrop) {
            backdrop.addEventListener('click', closeSidebar);
        }

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && isMobile() && isSidebarOpen()) {
                closeSidebar();
            }
        });

        const handleBreakpointChange = function () {
            appShell.classList.remove('sidebar-mobile-open', 'sidebar-collapsed');
            syncState();
        };

        if (typeof mobileQuery.addEventListener === 'function') {
            mobileQuery.addEventListener('change', handleBreakpointChange);
        } else if (typeof mobileQuery.addListener === 'function') {
            mobileQuery.addListener(handleBreakpointChange);
        }

        syncState();
    });
</script>
<script>
    (() => {
        const modal = document.getElementById('receiptPreviewModal');
        const frame = modal?.querySelector('.receipt-preview-frame');
        if (!modal || !frame) return;
        modal.addEventListener('show.bs.modal', (event) => {
            const link = event.relatedTarget;
            if (!link?.href) { event.preventDefault(); return; }
            const url = new URL(link.href, window.location.href);
            if (url.origin !== window.location.origin) { event.preventDefault(); return; }
            url.searchParams.set('embed', '1');
            frame.src = url.href;
        });
        frame.addEventListener('load', () => {
            try {
                frame.contentDocument?.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && modal.classList.contains('show')) {
                        event.preventDefault();
                        bootstrap.Modal.getInstance(modal)?.hide();
                    }
                });
            } catch (_) { /* The frame may have navigated away from this application. */ }
        });
        modal.addEventListener('hidden.bs.modal', () => { frame.src = 'about:blank'; });
    })();
</script>
