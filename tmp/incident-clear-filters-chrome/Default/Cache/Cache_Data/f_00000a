<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="icon" type="image/png" sizes="64x64" href="http://127.0.0.1:8027/images/vvthoa-favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --vf-navy: #062B80; --vf-royal: #0754C8; --vf-bright: #168DFF; --vf-light: #D8EDFF; --vf-background: #F0F8FF; --vf-white: #FFFFFF; --vf-green: #32A51F; }
        :root {
            --wb-primary: var(--vf-royal);
            --wb-text: var(--vf-navy);
            --wb-heading: var(--vf-navy);
            --wb-surface: #ffffff;
            --wb-primary-dark: var(--wb-primary);
            --wb-accent: var(--wb-primary);
            --wb-bg: var(--wb-surface);
            --wb-muted: var(--vf-navy);
            --wb-border: color-mix(in srgb, var(--wb-primary) 18%, var(--wb-surface));
            --wb-danger: var(--wb-primary);
            --wb-warning: var(--wb-primary);
            --wb-success: var(--wb-primary);
            --wb-info: var(--wb-primary);
            --sidebar-width: 244px;
            --sidebar-rail-width: 76px;
        }

        html {
            scrollbar-gutter: stable;
        }

        body {
            font-family: "Plus Jakarta Sans", sans-serif;
            background: color-mix(in srgb, var(--wb-primary) 5%, var(--wb-surface));
            color: var(--wb-text);
            overflow-y: scroll;
            overflow-x: hidden;
        }

        .auth-wrapper { min-height: 100vh; }
        .auth-card, .dashboard-card, .panel-card, .announcement-card {
            background: var(--wb-surface);
            border: 1px solid var(--wb-border);
            border-radius: 1rem;
            box-shadow: none;
        }

        .app-shell {
            min-height: 100vh;
            overflow-x: clip;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1035;
            width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            height: 100vh;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            background: var(--wb-primary);
            color: var(--wb-surface);
            transform: translateX(0);
            box-shadow: 3px 0 18px rgba(6, 43, 128, 0.12);
            transition: width 280ms ease-in-out, max-width 280ms ease-in-out, transform 280ms ease-in-out;
        }

        .sidebar-brand {
            min-width: 0;
            max-width: 100%;
            gap: 0.65rem !important;
            color: var(--wb-surface);
            text-decoration: none;
        }
        .sidebar-brand .organization-logo { width: 2.75rem; height: 2.75rem; flex: 0 0 auto; }
        .sidebar-brand > span {
            flex: 1 1 0%;
            min-width: 0;
            max-width: 100%;
            white-space: normal;
            overflow-wrap: break-word;
            opacity: 1;
            transition: opacity 280ms ease-in-out, max-width 280ms ease-in-out;
        }
        .sidebar-brand > span > span { display: block; white-space: normal; overflow-wrap: break-word; }
        .sidebar .nav-link {
            color: var(--wb-surface);
            border-radius: 0.8rem;
            padding: 0.68rem 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: var(--wb-surface);
            background: color-mix(in srgb, var(--wb-surface) 14%, var(--wb-primary));
            transform: none;
        }

        .sidebar .feature-icon,
        .sidebar .nav-link i {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            color: var(--wb-surface) !important;
        }

        .sidebar .small,
        .sidebar .opacity-75 {
            color: var(--wb-surface) !important;
            opacity: 1 !important;
        }

        .sidebar-nav-row {
            display: flex;
            align-items: center;
            border-radius: 0.8rem;
            transition: background 0.2s ease, transform 0.2s ease;
        }

        .sidebar-nav-row > .nav-link {
            flex: 1 1 auto;
            min-width: 0;
        }

        .sidebar-nav-row:hover,
        .sidebar-nav-row.active {
            background: color-mix(in srgb, var(--wb-surface) 14%, var(--wb-primary));
            transform: none;
        }

        .sidebar-nav-row > .nav-link:hover,
        .sidebar-nav-row > .nav-link.active {
            background: transparent;
            transform: none;
        }

        .sidebar-submenu-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 0.65rem;
            background: transparent;
            color: var(--wb-surface);
            padding: 0.55rem 0.7rem;
        }

        .sidebar-submenu-toggle:hover,
        .sidebar-submenu-toggle:focus-visible {
            background: color-mix(in srgb, var(--wb-surface) 12%, transparent);
        }

        .sidebar-submenu-toggle:focus-visible {
            outline: 2px solid var(--wb-surface);
            outline-offset: 2px;
        }

        .sidebar-submenu-toggle .bi {
            transition: transform 0.2s ease;
        }

        .sidebar-submenu-toggle[aria-expanded="true"] .bi {
            transform: rotate(180deg);
        }

        .sidebar-nav-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 2.25rem;
            height: 2.25rem;
            padding: 0;
            border: 1px solid color-mix(in srgb, var(--wb-surface) 24%, transparent);
            border-radius: 0.65rem;
            background: color-mix(in srgb, var(--wb-surface) 8%, transparent);
            color: var(--wb-surface);
            transition: background-color 280ms ease-in-out, border-color 280ms ease-in-out, box-shadow 280ms ease-in-out, transform 280ms ease-in-out;
        }

        .sidebar-nav-toggle:hover,
        .sidebar-nav-toggle:focus-visible {
            background: color-mix(in srgb, var(--wb-surface) 16%, transparent);
            border-color: color-mix(in srgb, var(--wb-surface) 38%, transparent);
            box-shadow: 0 0 12px rgba(22, 141, 255, 0.5);
            transform: scale(1.05);
        }

        .sidebar-nav-toggle:focus-visible {
            outline: 2px solid var(--wb-surface);
            outline-offset: 2px;
        }

        .sidebar-nav-toggle .bi {
            font-size: 0.9rem;
            transition: transform 280ms ease-in-out;
        }

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1030;
            background: rgba(6, 43, 128, 0.42);
            backdrop-filter: blur(3px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .sidebar :is(.nav, .nav-item, .sidebar-nav-row, .sidebar .collapse, .sidebar .collapsing) {
            min-width: 0;
            max-width: 100%;
            box-sizing: border-box;
        }

        .sidebar .collapsing {
            transition: height 250ms ease-in-out;
        }

        .sidebar .sidebar-subnav {
            min-width: 0;
            max-width: calc(100% - 2.35rem);
            box-sizing: border-box;
            gap: 0.15rem;
            margin: 0.3rem 0 0 2.35rem;
            padding-left: 0.65rem;
            border-left: 1px solid color-mix(in srgb, var(--wb-surface) 22%, transparent);
        }

        .sidebar-subnav .nav-link {
            color: color-mix(in srgb, var(--wb-surface) 72%, var(--wb-primary));
            font-size: 0.88rem;
            font-weight: 500;
            padding: 0.45rem 0.65rem;
            min-width: 0;
            max-width: 100%;
            box-sizing: border-box;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .sidebar .sidebar-subnav .nav-link > span:not(.badge) {
            min-width: 0;
            max-width: 100%;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .sidebar-subnav .badge { flex: 0 0 auto; }

        .sidebar-subnav .nav-link:hover,
        .sidebar-subnav .nav-link.active {
            color: var(--wb-surface);
            background: color-mix(in srgb, var(--wb-surface) 18%, var(--wb-primary));
            transform: none;
        }

        .sidebar-footer {
            background: color-mix(in srgb, var(--wb-surface) 10%, var(--wb-primary));
            border-radius: 0.9rem;
        }

        .main-content {
            flex: 1 1 0%;
            min-width: 0;
            margin-left: var(--sidebar-width);
            transition: margin-left 280ms ease-in-out;
        }

        @media (min-width: 992px) {
            .app-shell.sidebar-collapsed .sidebar { width: var(--sidebar-rail-width); max-width: var(--sidebar-rail-width); }
            .app-shell.sidebar-collapsed .main-content { margin-left: var(--sidebar-rail-width); }
            .sidebar .nav-link > span, .sidebar-nav-heading {
                white-space: nowrap; overflow: hidden; max-width: 220px; opacity: 1;
                transition: opacity 280ms ease-in-out, max-width 280ms ease-in-out;
            }
            .app-shell.sidebar-collapsed :is(.sidebar .nav-link > span, .sidebar-brand > span, .sidebar-nav-heading) { opacity: 0; max-width: 0; }
            .app-shell.sidebar-collapsed .sidebar-nav-heading { opacity: 0 !important; }
            .app-shell.sidebar-collapsed .sidebar-brand { justify-content: center; gap: 0 !important; }
            .app-shell.sidebar-collapsed .sidebar-brand > span { max-height: 0; overflow: hidden; }
            .app-shell.sidebar-collapsed .sidebar-brand .organization-logo { width: 2.5rem; height: 2.5rem; }
            .app-shell.sidebar-collapsed .sidebar-nav-header { justify-content: center !important; gap: 0 !important; }
            .app-shell.sidebar-collapsed .sidebar-nav-toggle .bi { transform: rotate(180deg); }
            .app-shell.sidebar-collapsed .sidebar .nav-link { justify-content: center; gap: 0; padding-left: 0; padding-right: 0; }
            .app-shell.sidebar-collapsed .sidebar-nav-row > .nav-link { min-width: 0; }
            .app-shell.sidebar-collapsed .sidebar-submenu-toggle { flex: 0 0 1.35rem; padding: 0.55rem 0; }
            .app-shell.sidebar-collapsed :is(.sidebar-subnav, .sidebar .collapse) { display: none !important; }
        }
        .topbar {
            background: var(--wb-surface);
            border-bottom: 1px solid var(--wb-border);
        }

        .topbar .container-fluid {
            gap: 0.75rem;
            min-width: 0;
        }

        .content-wrapper { padding: 1.5rem; }
        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .page-heading h1 {
            font-size: 1.85rem;
            font-weight: 800;
            margin-bottom: 0.35rem;
        }

        .page-heading p { color: var(--wb-muted); margin-bottom: 0; }
        .metric-icon, .feature-icon {
            width: 3rem;
            height: 3rem;
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .metric-icon { background: color-mix(in srgb, var(--wb-primary) 10%, var(--wb-surface)); color: var(--wb-primary); }
        .feature-icon { background: color-mix(in srgb, var(--wb-primary) 10%, var(--wb-surface)); color: var(--wb-primary); }
        .section-title { font-size: 1rem; font-weight: 800; margin-bottom: 1rem; }
        .table thead th {
            color: var(--wb-muted);
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0;
            border-bottom-width: 1px;
        }

        .table td, .table th { vertical-align: middle; }
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        img,
        svg,
        canvas,
        iframe {
            max-width: 100%;
        }

        .row > * {
            min-width: 0;
        }

        .panel-card,
        .dashboard-card,
        .announcement-card,
        .modal-content,
        .card {
            min-width: 0;
        }
        .badge-soft-primary,
        .badge-soft-success,
        .badge-soft-warning,
        .badge-soft-danger,
        .badge-soft-info {
            background: color-mix(in srgb, var(--wb-primary) 9%, var(--wb-surface));
            border: 1px solid color-mix(in srgb, var(--wb-primary) 20%, var(--wb-surface));
            color: var(--wb-primary);
            font-weight: 800;
        }

        .chart-bars { display: flex; align-items: end; gap: 0.75rem; height: 220px; }
        .chart-bar {
            flex: 1;
            border-radius: 1rem 1rem 0.45rem 0.45rem;
            background: var(--wb-primary);
            position: relative;
        }

        .chart-label {
            display: block;
            margin-top: 0.65rem;
            text-align: center;
            color: var(--wb-muted);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-dot {
            width: 0.65rem;
            height: 0.65rem;
            border-radius: 50%;
            display: inline-block;
        }

        .timeline-item {
            display: flex;
            gap: 0.9rem;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
            border-bottom: 1px dashed var(--wb-border);
        }

        .timeline-item:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
        .danger-strip { border-left: 4px solid var(--wb-primary); }
        .avatar-badge {
            width: 2.2rem;
            height: 2.2rem;
        }

        .chart-62 { height: 62%; }
        .chart-68 { height: 68%; }
        .chart-74 { height: 74%; }
        .chart-84 { height: 84%; }
        .chart-88 { height: 88%; }
        .chart-95 { height: 95%; }

        .notification-menu {
            width: 340px;
            max-width: min(340px, calc(100vw - 2rem));
        }

        .notification-item,
        .notification-item-body,
        .notification-item-title,
        .notification-item-message {
            min-width: 0;
            max-width: 100%;
        }

        .notification-item-title,
        .notification-item-message {
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .rag-indicator { white-space: nowrap; }
        .rag-dot { width: 0.65rem; height: 0.65rem; border-radius: 50%; display: inline-block; flex-shrink: 0; }
        .rag-dot-sm { width: 0.45rem; height: 0.45rem; border-radius: 50%; display: inline-block; flex-shrink: 0; }
        .rag-dot-lg { width: 0.85rem; height: 0.85rem; border-radius: 50%; display: inline-block; flex-shrink: 0; }
        .rag-green { background: var(--vf-green); }
        .rag-amber { background: #f59e0b; }
        .rag-red { background: #ef4444; }
        .rag-orange { background: #f97316; }
        .rag-yellow { background: #eab308; }
        .rag-blue { background: var(--vf-bright); }
        .rag-green-text { color: var(--vf-green); font-weight: 700; }
        .rag-amber-text { color: #d97706; font-weight: 700; }
        .rag-red-text { color: #dc2626; font-weight: 700; }
        .rag-orange-text { color: #ea580c; font-weight: 700; }
        .rag-yellow-text { color: #ca8a04; font-weight: 700; }
        .rag-blue-text { color: var(--vf-bright); font-weight: 700; }

        @media (max-width: 991.98px) {
            .app-shell {
                display: block !important;
            }

            .sidebar {
                width: min(85vw, var(--sidebar-width));
                max-width: min(85vw, var(--sidebar-width));
                min-height: 100vh;
                transform: translateX(-100%);
            }

            .app-shell.sidebar-collapsed .sidebar {
                transform: translateX(-100%);
            }

            .app-shell.sidebar-mobile-open .sidebar {
                transform: translateX(0);
            }

            .main-content,
            .app-shell.sidebar-collapsed .main-content {
                margin-left: 0;
            }

            .app-shell.sidebar-mobile-open .sidebar-backdrop {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            .content-wrapper { padding: 1rem; }
            .page-heading {
                flex-direction: column;
                align-items: stretch;
            }

            .page-heading > * {
                max-width: 100%;
            }

            .topbar .container-fluid {
                flex-wrap: wrap;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .sidebar,
            .main-content,
            .sidebar-backdrop,
            .sidebar-nav-toggle,
            .sidebar-nav-toggle .bi,
            .sidebar .nav-link > span,
            .sidebar-brand > span,
            .sidebar-nav-heading,
            .sidebar .collapsing {
                transition: none !important;
                animation: none !important;
            }
        }
        .status-filter-display { position: relative; }
        .status-filter-display .status-filter-value { position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: #495057; white-space: nowrap; max-width: calc(100% - 6rem); overflow: hidden; text-overflow: ellipsis; }
</style>
    <style>
        :root {
            --bs-primary: var(--wb-primary);
            --bs-secondary: var(--wb-text);
            --bs-success: var(--wb-primary);
            --bs-info: var(--wb-primary);
            --bs-warning: var(--wb-primary);
            --bs-danger: var(--wb-primary);
            --bs-light: var(--wb-surface);
            --bs-dark: var(--wb-text);
            --bs-body-color: var(--wb-text);
            --bs-body-bg: var(--wb-surface);
            --bs-border-color: var(--wb-border);
            --bs-link-color: var(--wb-primary);
            --bs-link-hover-color: var(--wb-primary);
        }

        body,
        .main-content,
        .content-wrapper {
            color: var(--wb-text);
        }

        body * {
            letter-spacing: 0;
        }

        .page-heading {
            align-items: end;
        }

        .page-heading h1 {
            color: var(--wb-text);
            font-size: 1.85rem;
            line-height: 1.15;
        }

        .page-heading p,
        .text-secondary,
        .text-muted,
        .form-text,
        .small.text-secondary {
            color: var(--wb-muted) !important;
        }

        .panel-card,
        .dashboard-card,
        .auth-card,
        .announcement-card,
        .modal-content,
        .card,
        [class*="summary-card"],
        [class*="stat-card"],
        [class*="focus-card"],
        [class*="preview-card"],
        [class*="qr-card"],
        [class*="table-card"],
        [class*="filter-card"],
        [class*="indicator"],
        [class*="open-item"],
        [class*="history-item"],
        .role-register-section,
        [class*="role-card"] {
            background: var(--wb-surface) !important;
            border: 1px solid var(--wb-border) !important;
            border-radius: 1rem !important;
            box-shadow: none !important;
            color: var(--wb-text);
        }

        [class*="dropzone"],
        [class*="upload"],
        [class*="empty-state"],
        [class*="workspace"],
        [class*="summary-row"],
        [class*="toolbar"],
        [class*="topline"],
        [class*="meter-phone-frame"],
        [class*="receipt-phone-frame"],
        [class*="org-qr-box"],
        [class*="password-indicator"],
        [class*="chart"] {
            border-color: var(--wb-border) !important;
            background: color-mix(in srgb, var(--wb-primary) 5%, var(--wb-surface)) !important;
            color: var(--wb-text) !important;
            box-shadow: none !important;
        }

        [class*="icon"],
        [class*="avatar"],
        .status-dot {
            background: color-mix(in srgb, var(--wb-primary) 10%, var(--wb-surface)) !important;
            color: var(--wb-primary) !important;
            border-color: var(--wb-border) !important;
        }

        .btn,
        button.btn,
        a.btn {
            min-height: 2.6rem;
            border-radius: 0.8rem !important;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
        }

        .btn-sm {
            min-height: 2.25rem;
            border-radius: 0.7rem !important;
        }

        .btn-primary,
        .btn-success,
        .btn-danger,
        .btn-warning,
        .btn-info {
            background: var(--wb-primary) !important;
            border-color: var(--wb-primary) !important;
            color: var(--wb-surface) !important;
        }

        .btn-outline-primary,
        .btn-outline-secondary,
        .btn-outline-success,
        .btn-outline-danger,
        .btn-outline-warning,
        .btn-outline-info,
        .btn-light,
        .btn-close,
        .minimal-link {
            border-color: var(--wb-border) !important;
            color: var(--wb-primary) !important;
        }

        .btn-outline-primary,
        .btn-outline-secondary,
        .btn-outline-success,
        .btn-outline-danger,
        .btn-outline-warning,
        .btn-outline-info,
        .btn-light {
            background: var(--wb-surface) !important;
        }

        .btn:hover,
        .minimal-link:hover {
            filter: none;
            opacity: 1;
        }

        .form-control,
        .form-select,
        .input-group-text,
        textarea {
            min-height: 2.7rem;
            border-color: var(--wb-border) !important;
            border-radius: 0.8rem !important;
            color: var(--wb-text) !important;
            background-color: var(--wb-surface) !important;
            font-weight: 600;
        }

        .input-group .form-control,
        .input-group .form-select,
        .input-group .input-group-text {
            border-radius: 0.8rem !important;
        }

        .form-control:focus,
        .form-select:focus,
        textarea:focus {
            border-color: var(--wb-primary) !important;
            box-shadow: none !important;
        }

        .alert,
        .alert-success,
        .alert-danger,
        .alert-warning,
        .alert-info {
            background: var(--wb-surface) !important;
            border: 1px solid var(--wb-border) !important;
            border-radius: 0.9rem !important;
            color: var(--wb-text) !important;
            font-weight: 700;
        }

        .alert-success {
            background: color-mix(in srgb, var(--vf-green) 11%, var(--wb-surface)) !important;
            border-color: color-mix(in srgb, var(--vf-green) 34%, var(--wb-surface)) !important;
            color: var(--vf-green) !important;
        }

        .alert-success i {
            color: var(--vf-green) !important;
        }

        .alert-danger {
            background: color-mix(in srgb, #ef4444 10%, var(--wb-surface)) !important;
            border-color: color-mix(in srgb, #ef4444 34%, var(--wb-surface)) !important;
            color: #991b1b !important;
        }

        .alert-danger i {
            color: #dc2626 !important;
        }

        .badge,
        .badge-soft-primary,
        .badge-soft-success,
        .badge-soft-warning,
