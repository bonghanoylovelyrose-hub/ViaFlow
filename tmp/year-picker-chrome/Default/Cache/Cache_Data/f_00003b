                        dialog.showModal();
                        selected.focus({ preventScroll: true });
                        selected.closest('label').scrollIntoView({ block: 'nearest' });
                    });
                    dialog.querySelector('[data-year-picker-cancel]').addEventListener('click', () => dialog.close());
                    dialog.querySelector('[data-year-picker-apply]').addEventListener('click', () => {
                        select.value = dialog.querySelector('input:checked').value;
                        trigger.textContent = select.selectedOptions[0].textContent;
