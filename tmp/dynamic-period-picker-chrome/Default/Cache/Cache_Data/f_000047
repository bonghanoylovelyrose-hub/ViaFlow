        currentReadingInput.addEventListener('keydown', function (e) {
            if (e.key === '-' || e.key === '+' || e.key === 'e' || e.key === 'E') {
                e.preventDefault();
            }
        });

        async function confirmMeterReadingSubmission() {
            if (!meterReadingForm || meterReadingSubmissionProcessing) {
                return;
