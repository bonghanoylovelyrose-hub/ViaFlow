        .dashboard-card,
        .auth-card,
        .announcement-card,
        .modal-content,
        .card,
        [class*="summary-card"],
        [class*="stat-card"],
        [class*="focus-card"],
        [class*="preview-card"],
        [class*="qr-card"],
        [class*="table-card"],
        [class*="filter-card"],
        [class*="indicator"],
        [class*="open-item"],
        [class*="history-item"],
        .role-register-section,
        [class*="role-card"] {
