    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('select[data-clearable-filter]').forEach(function (select, index) {
                if (!Array.from(select.options).some(function (option) { return option.hasAttribute('selected'); })) {
                    select.selectedIndex = -1;
                }
                const defaults = {
                    status: 'All Status', application_status: 'All Status', notice_status: 'All Status',
                    channel: 'All Methods', payment_type: 'All Types', type: 'All Types',
                    category: 'All Categories', month: 'All Months', year: 'All Years',
                    membership: 'All Memberships', notice_membership: 'All Memberships'
                };
                const label = select.dataset.filterDefault || defaults[select.name];
                if (!label) return;
                const value = document.createElement('span');
                value.className = 'status-filter-value';
                value.id = 'filter-default-' + index;
                value.textContent = label;
                value.style.fontSize = window.getComputedStyle(select).fontSize;
                select.parentElement.classList.add('status-filter-display');
                select.insertAdjacentElement('afterend', value);
                const update = function () {
                    const empty = select.selectedIndex < 0;
                    value.hidden = !empty;
                    if (empty) select.setAttribute('aria-describedby', value.id);
                    else select.removeAttribute('aria-describedby');
                };
                select.addEventListener('change', update);
                update();
            });
            document.querySelectorAll('form[data-auto-filter]').forEach(function (form) {
                let timer = null;

                const clearTimer = function () {
                    if (timer !== null) {
                        window.clearTimeout(timer);
                        timer = null;
                    }
                };

                const submit = function () {
                    clearTimer();

                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                };

                const scheduleSubmit = function () {
                    clearTimer();

                    const configuredDelay = Number(form.dataset.autoFilterDebounce);
                    const delay = Number.isFinite(configuredDelay) && configuredDelay >= 0
                        ? configuredDelay
                        : 450;

                    timer = window.setTimeout(submit, delay);
                };

                form.querySelectorAll('select, input[type="month"], input[type="date"], input[type="week"], input[type="time"], input[type="checkbox"], input[type="radio"]').forEach(function (control) {
                    control.addEventListener('change', submit);
                });

                form.querySelectorAll('input[type="search"], input[type="text"]').forEach(function (input) {
                    input.addEventListener('input', scheduleSubmit);
                    input.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            submit();
                        }
                    });
                });

                form.addEventListener('submit', clearTimer);
                form.addEventListener('period-picker-open', clearTimer);

                form.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', clearTimer);
                });

                document.addEventListener('click', function (event) {
                    if (!form.contains(event.target)) {
                        clearTimer();
                    }
                }, true);

                window.addEventListener('pagehide', clearTimer);
            });
        });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const welcome = document.getElementById('loginWelcome');
        const shell = welcome.closest('.role-login-shell');
        const panel = document.getElementById('loginPanel');
        const form = panel.querySelector('form');
        const countdown = document.getElementById('loginCountdown');
        const countdownBar = document.getElementById('loginCountdownBar');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const idleDuration = 30000;
        let deadline = 0;
        let timer = null;
        let returnTimer = null;
        let submitting = false;
        let composing = false;

        function stopCountdown() {
            window.clearTimeout(timer);
            timer = null;
        }

        function returnToWelcome() {
            stopCountdown();
            welcome.hidden = false;
            welcome.removeAttribute('aria-hidden');
            welcome.tabIndex = 0;
            shell.classList.add('is-returning');
            // Establish the transparent welcome state before fading it back in.
            void welcome.offsetWidth;
            shell.classList.remove('is-revealed');
            panel.inert = true;
            welcome.focus({ preventScroll: true });
            returnTimer = window.setTimeout(function () {
                shell.classList.remove('is-returning');
                returnTimer = null;
            }, reducedMotion.matches ? 0 : 500);
        }

        function tickCountdown() {
            const remaining = Math.max(0, deadline - Date.now());
            countdown.textContent = String(Math.ceil(remaining / 1000));
            countdownBar.style.transform = 'scaleX(' + (remaining / idleDuration) + ')';
            if (remaining === 0) {
                returnToWelcome();
            } else {
                timer = window.setTimeout(tickCountdown, Math.min(200, remaining));
            }
        }

        function resetCountdown() {
            if (!shell.classList.contains('is-revealed') || submitting || composing) return;
            stopCountdown();
            deadline = Date.now() + idleDuration;
            tickCountdown();
        }

        welcome.addEventListener('click', function () {
            window.clearTimeout(returnTimer);
            shell.classList.remove('is-returning');
            panel.inert = false;
            shell.classList.add('is-revealed');
            welcome.tabIndex = -1;
            welcome.setAttribute('aria-hidden', 'true');
            document.getElementById('login').focus({ preventScroll: true });
            if (reducedMotion.matches) {
                welcome.hidden = true;
            } else {
                welcome.addEventListener('transitionend', function (event) {
                    if (event.propertyName === 'opacity' && shell.classList.contains('is-revealed')) welcome.hidden = true;
                }, { once: true });
            }
            resetCountdown();
        });
        ['pointerdown', 'click', 'keydown', 'input', 'change', 'focusin'].forEach(function (eventName) {
            panel.addEventListener(eventName, resetCountdown);
        });
        panel.addEventListener('compositionstart', function () { composing = true; stopCountdown(); });
        panel.addEventListener('compositionend', function () { composing = false; resetCountdown(); });
        form.addEventListener('submit', function () { submitting = true; stopCountdown(); });
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) { submitting = false; resetCountdown(); }
        });
        document.querySelectorAll('.password-toggle').forEach(function (button) {
            button.addEventListener('click', function () {
                const input = document.getElementById(button.dataset.target);
                const icon = button.querySelector('i');
                const showPassword = input.type === 'password';

                input.type = showPassword ? 'text' : 'password';
                button.setAttribute('aria-label', showPassword ? 'Hide password' : 'Show password');
                button.setAttribute('aria-pressed', showPassword ? 'true' : 'false');
                icon.className = showPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    });
</script>
</body>
</html>
